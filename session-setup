#!/usr/bin/env bash
#
# session-setup: get a 1337/42 post ready to work on.
#
# Installs the official Brave and VS Code builds in goinfre (the flatpak ones
# can't use the GPU on these machines), copies your data over from the flatpak
# apps once and opens them. IntelliJ IDEA can be added the same way, on request.
#
# session-setup --help for the options, README.md for the details.

set -euo pipefail

VERSION=1.2.0
SELF=$(readlink -f "${BASH_SOURCE[0]}")

# Inside a flatpak (e.g. the VS Code flatpak terminal): run on the host instead,
# remembering which app we came from so we never close the terminal we run in.
if [ -f /.flatpak-info ] && [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  if command -v host-spawn >/dev/null; then exec host-spawn "$SELF" --from-flatpak "${FLATPAK_ID:-}" "$@"; fi
  if flatpak-spawn --host true 2>/dev/null; then
    exec flatpak-spawn --host "$SELF" --from-flatpak "${FLATPAK_ID:-}" "$@"
  fi
  echo "This terminal runs inside the ${FLATPAK_ID:-flatpak} sandbox, which can't reach the rest of the system." \
       "Run session-setup from a regular terminal (Ctrl+Alt+T)." >&2
  exit 1
fi

USER=${USER:-$(id -un)}
CONF_DIR=${XDG_CONFIG_HOME:-$HOME/.config}
DATA_DIR=${XDG_DATA_HOME:-$HOME/.local/share}
INSTALL_DIR="$HOME/.local/bin"
STATE_DIR="$CONF_DIR/session-setup"

VSCODE_API="https://update.code.visualstudio.com/api/update/linux-x64/stable/latest"
BRAVE_VERSION_URL="https://versions.brave.com/latest/release-linux-x64.version"
BRAVE_CACHE_BYTES=524288000   # 500 MB
# Without its own window class the dock shows native Brave as the flatpak one.
# VS Code ignores --class, but its "code" already differs from the flatpak's "Code".
BRAVE_WM_CLASS=brave-native

# IntelliJ IDEA is optional (--add idea). It's a single download: the free features
# work as is, the paid ones need a license.
IDEA_API="https://data.services.jetbrains.com/products/releases?code=IIU&latest=true&type=release"
IDEA_FREE_MB=8000   # 1.6 GB download and 4.3 GB unpacked, both on disk for a moment
OPTIONAL="$STATE_DIR/optional"
IDEA_MARKER="$STATE_DIR/idea-import"

# Default data folders of the native apps
NEW_VSCODE="$CONF_DIR/Code"
NEW_BRAVE="$CONF_DIR/BraveSoftware/Brave-Browser"
MARKER=".session-setup-import"

# Left out when copying profiles, all of it gets rebuilt
CACHE_EXCLUDES=(
  --exclude='Singleton*' --exclude='*.lock' --exclude='*.sock' --exclude='.org.chromium.*'
  --exclude='Cache' --exclude='CachedData' --exclude='CachedProfilesData' --exclude='CachedExtensionVSIXs'
  --exclude='Code Cache' --exclude='GPUCache' --exclude='GPUPersistentCache' --exclude='GrShaderCache'
  --exclude='GraphiteDawnCache' --exclude='ShaderCache' --exclude='DawnGraphiteCache'
  --exclude='DawnWebGPUCache' --exclude='CacheStorage' --exclude='sdk-cache' --exclude='Crash Reports'
  --exclude='Crashpad' --exclude='logs' --exclude='component_crx_cache' --exclude='extensions_crx_cache'
  --exclude="$MARKER"
)
FAILED=0

usage() {
  cat <<'EOF'
usage: session-setup [options]

  (no options)               install/update Brave and VS Code, copy your data from
                             the flatpak apps (first run only), open both
  --prepare                  only install/update and copy data
  --close-old                close the flatpak Brave and VS Code first (they can
                             keep running in the background after you close them)
  --reimport [vscode|brave|idea]
                             copy the flatpak data again; the current native data
                             is moved to <goinfre>/backups first
  --add idea                 also set up IntelliJ IDEA (optional, about 4.3 GB in
                             goinfre), with an `idea` command and an app entry
  --remove idea              stop setting up IntelliJ IDEA (your settings are kept)
  open vscode|brave|idea [ARGS]
                             start the native app (what `code`, `brave`, `idea` and
                             the app grid entries run)
  --version                  print the version
EOF
}

if [ -t 1 ]; then
  log()  { printf '\033[1;32m==>\033[0m %s\n' "$*"; }
  warn() { printf '\033[1;33m!!\033[0m  %s\n' "$*" >&2; }
else
  log()  { printf '==> %s\n' "$*"; }
  warn() { printf '!!  %s\n' "$*" >&2; }
fi
notify()    { notify-send "session-setup" "$*" 2>/dev/null || true; }
json_get()  { python3 -c 'import json,sys; print(json.load(sys.stdin)[sys.argv[1]])' "$1"; }
pretty()    { echo "${1/#$HOME/\~}"; }
label()     { case "$1" in vscode) echo "VS Code" ;; brave) echo "Brave" ;; idea) echo "IntelliJ IDEA" ;; *) echo "$1" ;; esac; }
quit_hint() { case "$1" in vscode|idea) echo "File > Exit" ;; brave) echo "Ctrl+Shift+Q" ;; esac; }
optional_on() { grep -qsx "$1" "$OPTIONAL"; }

# --- finding things --------------------------------------------------------------

find_goinfre() {
  if [ -n "${GOINFRE:-}" ]; then echo "$GOINFRE"
  elif [ -d /goinfre ]; then echo "/goinfre/$USER"
  elif [ -d "$HOME/goinfre" ]; then readlink -f "$HOME/goinfre"
  else echo "$HOME/.local/opt"
  fi
}

# most recently modified of the given paths, or nothing
newest() { find "$@" -maxdepth 0 -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -n1 | cut -d' ' -f2- || true; }

# highest version among the given node bin folders (glob results), or nothing
latest_bin() { [ -d "$1" ] && printf '%s\n' "$@" | sort -V | tail -n1; }

# ~/.var/app/<id> or ~/snap/<name>/current, for data that belongs to a flatpak/snap
app_root() {
  local rest
  case "$1" in
    "$HOME"/.var/app/*) rest=${1#"$HOME"/.var/app/}; echo "$HOME/.var/app/${rest%%/*}" ;;
    "$HOME"/snap/*)     rest=${1#"$HOME"/snap/};     echo "$HOME/snap/${rest%%/*}/current" ;;
  esac
}

# Main process(es) of the old app; empty once it has quit, even when helpers it
# leaves behind (crash reporter, settings monitor) keep its flatpak sandbox alive.
old_app_pids() {
  local root roots; root=$(app_root "$1")
  case "$root" in
    "$HOME"/.var/app/*)
      roots=$(flatpak ps --columns=child-pid,application 2>/dev/null |
              awk -v id="$(basename "$root")" '$2 == id {printf "%s ", $1}')
      [ -n "$roots" ] || return 0
      # processes directly inside a sandbox, minus sandboxes, helpers and --type= children
      ps -eo pid=,ppid=,args= | awk -v roots="$roots" '
        BEGIN { n = split(roots, r, " "); for (i = 1; i <= n; i++) root[r[i]] = 1 }
        root[$2] && $3 !~ /(^|\/)(bwrap|cat|gsettings)$/ && $3 !~ /crashpad_handler/ && $0 !~ /--type=/ { print $1 }' ;;
    "$HOME"/snap/*)
      pgrep -f "/snap/$(basename "$(dirname "$root")")/" || true ;;
  esac
}

old_app_running() { [ -n "$(old_app_pids "$1")" ]; }

# close_old_app NAME OLD
# Asks the old app's main process to quit, so it closes its windows and saves its
# session (signalling its helpers first makes it show crash dialogs instead).
# Forces it after 15 s, then clears whatever it left behind in its sandbox.
close_old_app() {
  local name=$1 old=$2 root id="" snap="" p
  old_app_running "$old" || return 0
  root=$(app_root "$old")
  case "$root" in
    "$HOME"/.var/app/*) id=$(basename "$root") ;;
    "$HOME"/snap/*)     snap=$(basename "$(dirname "$root")") ;;
  esac
  if [ -n "$id" ] && [ "$id" = "$FROM_FLATPAK" ]; then
    warn "This is running in the flatpak $(label "$name")'s own terminal, which would close too." \
         "Run it from a regular terminal (Ctrl+Alt+T) instead"
    return 1
  fi
  log "Closing the flatpak $(label "$name")"
  for p in $(old_app_pids "$old"); do kill -TERM "$p" 2>/dev/null || true; done
  for _ in $(seq 1 15); do old_app_running "$old" || break; sleep 1; done
  if [ -n "$id" ]; then
    flatpak kill "$id" 2>/dev/null || true
  elif old_app_running "$old"; then
    pkill -KILL -f "/snap/$snap/" 2>/dev/null || true
  fi
  sleep 1
  if old_app_running "$old"; then warn "Couldn't close the flatpak $(label "$name")"; return 1; fi
}

# The old app is running while its data needs copying: close it if --close-old
# was given or the user says yes. Never asks when started from an app entry.
offer_close_old() {
  local name=$1 old=$2 answer
  if [ "$CLOSE_OLD" != 1 ]; then
    if [ "$MODE" = open ] || [ ! -t 0 ]; then return 1; fi
    read -r -p "The flatpak $(label "$name") is still running (maybe in the background). Close it now? [Y/n] " answer || return 1
    case "$answer" in ""|[Yy]*) ;; *) return 1 ;; esac
  fi
  close_old_app "$name" "$old"
}

find_vscode_extensions() {
  local root; root=$(app_root "$OLD_VSCODE")
  if [ -n "$root" ] && [ -d "$root/data/vscode/extensions" ]; then echo "$root/data/vscode/extensions"
  else echo "$HOME/.vscode/extensions"
  fi
}

# node from nvm wherever it is, preferring nvm's default version
find_node_bin() {
  local d def bin
  for d in "${NVM_DIR:-}" "$HOME/.nvm" "$HOME"/.var/app/*/config/nvm; do
    if [ -z "$d" ] || [ ! -d "$d/versions/node" ]; then continue; fi
    def=$(cat "$d/alias/default" 2>/dev/null || true)
    bin=$(latest_bin "$d/versions/node/v${def#v}"*/bin || true)
    [ -n "$bin" ] || bin=$(latest_bin "$d"/versions/node/*/bin || true)
    [ -n "$bin" ] && { echo "$bin"; return 0; }
  done
}

# --- installing the apps (goinfre) -----------------------------------------------

# ensure_app NAME LATEST URL SHA256 SUBDIR [FREE_MB]
# The old install is only replaced once the new one is downloaded and checked.
# (set -e doesn't apply in functions called with ||, so every step is checked.)
ensure_app() {
  local name=$1 latest=$2 url=$3 sha=$4 subdir=$5 need=${6:-0} dest="$APPS/$1" have tmp free
  have=$(cat "$dest/.installed-version" 2>/dev/null || true)
  if [ -z "$latest" ]; then
    if [ -n "$have" ]; then warn "$(label "$name"): no answer from the update server, keeping $have"; return 0; fi
    warn "$(label "$name"): can't reach the download server"; return 1
  fi
  if [ "$have" = "$latest" ]; then log "$(label "$name") $have (up to date)"; return 0; fi
  if [ -n "$have" ] && pgrep -f "$dest/" >/dev/null; then
    warn "$(label "$name") $latest is out, close it and run again to update (keeping $have for now)"; return 0
  fi

  free=$(df -Pm "$GOINFRE" | awk 'NR == 2 {print $4}')
  if [ "${free:-0}" -lt "$need" ]; then
    warn "$(label "$name") needs about $((need / 1000)) GB free in $GOINFRE, there's $((free / 1000)) GB"; return 1
  fi
  log "Downloading $(label "$name") $latest to $dest"
  tmp=$(mktemp -d "$GOINFRE/.download.XXXXXX")
  if ! { curl -fL --progress-bar -o "$tmp/archive" "$url" &&
         echo "$sha  $tmp/archive" | sha256sum -c --quiet - &&
         mkdir "$tmp/x" &&
         case "$url" in
           *.zip) unzip -q "$tmp/archive" -d "$tmp/x" ;;
           *)     tar -xzf "$tmp/archive" -C "$tmp/x" ;;
         esac; }; then
    rm -rf "$tmp"; warn "$(label "$name"): download failed or checksum didn't match"; return 1
  fi
  if ! { [ -d "$tmp/x/$subdir" ] && echo "$latest" > "$tmp/x/$subdir/.installed-version"; }; then
    rm -rf "$tmp"; warn "$(label "$name"): the download doesn't look like it used to, keeping the current version"; return 1
  fi
  rm -rf "$dest" && mv "$tmp/x/$subdir" "$dest" && rm -rf "$tmp"
}

install_vscode() {
  local meta latest="" url="" sha=""
  if meta=$(curl -fsSL --max-time 15 "$VSCODE_API"); then
    latest=$(json_get productVersion <<<"$meta")
    url=$(json_get url <<<"$meta")
    sha=$(json_get sha256hash <<<"$meta")
  fi
  ensure_app vscode "$latest" "$url" "$sha" VSCode-linux-x64
}

install_brave() {
  local latest="" url="" sha=""
  if latest=$(curl -fsSL --max-time 15 "$BRAVE_VERSION_URL") && [[ $latest =~ ^[0-9.]+$ ]]; then
    url="https://github.com/brave/brave-browser/releases/download/v$latest/brave-browser-$latest-linux-amd64.zip"
    sha=$(curl -fsSL --max-time 15 "$url.sha256" | cut -d' ' -f1) || latest=""
  else
    latest=""
  fi
  ensure_app brave "$latest" "$url" "$sha" ""
}

install_idea() {
  local meta latest="" build="" url="" sum="" sha=""
  if meta=$(curl -fsSL --max-time 15 "$IDEA_API") &&
     read -r latest build url sum < <(python3 -c '
import json, sys
r = json.load(sys.stdin)["IIU"][0]; l = r["downloads"]["linux"]
print(r["version"], r["build"], l["link"], l["checksumLink"])' <<<"$meta" 2>/dev/null); then
    sha=$(curl -fsSL --max-time 15 "$sum" | cut -d' ' -f1) || latest=""
  else
    latest=""
  fi
  ensure_app idea "$latest" "$url" "$sha" "idea-IU-$build" "$IDEA_FREE_MB"
}

# --- copying data from the flatpak apps (home) -----------------------------------

# the native app already holds real data, not just the empty folders a first start leaves
has_real_data() { [ -e "$1/Default/Preferences" ] || [ -e "$1/User/globalStorage/state.vscdb" ]; }

# import_data NAME OLD NEW
# Copies everything except caches, once. The flatpak copy is never changed.
import_data() {
  local name=$1 old=$2 new=$3 bak root
  [ -n "$old" ] || return 0
  if [[ " $REIMPORT " != *" $name "* ]]; then
    [ -f "$new/$MARKER" ] && return 0
    if has_real_data "$new"; then
      printf 'kept=existing\ndate=%s\n' "$(date -Is)" > "$new/$MARKER"
      log "Keeping the $(label "$name") data you already had in $(pretty "$new") (--reimport $name to use the flatpak one)"
      return 0
    fi
  fi
  if old_app_running "$old" && ! offer_close_old "$name" "$old"; then
    warn "The flatpak $(label "$name") is still running (it can keep running in the background after you close" \
         "its window). Quit it ($(quit_hint "$name")) or run: session-setup --close-old"
    return 1
  fi
  if pgrep -f "$APPS/$name/" >/dev/null; then warn "Close the native $(label "$name") and run again"; return 1; fi
  if [ -e "$new" ]; then
    bak="$GOINFRE/backups/$(basename "$new")-$(date +%Y%m%d-%H%M%S)"
    { mkdir -p "$GOINFRE/backups" && mv "$new" "$bak"; } || { warn "Couldn't move $new out of the way"; return 1; }
    log "Moved the previous $(pretty "$new") to $bak"
  fi
  log "Copying your $(label "$name") data from $(pretty "$old")"
  mkdir -p "$(dirname "$new")"
  if ! { rsync -a "${CACHE_EXCLUDES[@]}" "$old/" "$new.partial/" &&
         printf 'from=%s\ndate=%s\n' "$old" "$(date -Is)" > "$new.partial/$MARKER" &&
         mv "$new.partial" "$new"; }; then
    warn "Copying the $(label "$name") data failed"; return 1
  fi
  root=$(app_root "$old")
  [ -z "$root" ] || carry_tool_configs "$root"
}

# Tools used from a flatpak terminal keep their config in the app's own folder
# (git's global ignore file for example). Copy what the host doesn't have yet.
carry_tool_configs() {
  local root=$1 kind dest item name
  for kind in config data; do
    if [ "$kind" = config ]; then dest=$CONF_DIR; else dest=$DATA_DIR; fi
    for item in "$root/$kind"/*; do
      [ -e "$item" ] || continue
      name=$(basename "$item")
      case "$name" in   # the apps' own data, nvm (used where it is), desktop and sandbox stuff
        BraveSoftware|Code|vscode|JetBrains|nvm|dconf|glib-2.0|gtk-*|ibus|pulse|fontconfig|user-dirs.*|\
        recently-used.xbel|flatpak*|mimeapps.list|QtProject.conf|kdeglobals|keyrings|npmrc) continue ;;
      esac
      [ -e "$dest/$name" ] && continue
      mkdir -p "$dest" && cp -a "$item" "$dest/" && log "Copied $kind/$name from $(pretty "$root") to $(pretty "$dest")/"
    done
  done
}

# IntelliJ imports the settings of an earlier version by itself on its first start
# when it finds them in ~/.config/JetBrains (that's how it upgrades). So the flatpak
# settings and plugins are copied there under their own name, IntelliJ does the rest.
import_idea() {
  local old=$OLD_IDEA name conf plug oldplug root bak d
  [ -n "$old" ] || return 0
  name=$(basename "$old") root=$(app_root "$old")
  conf="$CONF_DIR/JetBrains/$name" plug="$DATA_DIR/JetBrains/$name"
  oldplug="$root/data/JetBrains/$name"                                 # flatpak
  [ -d "$oldplug" ] || oldplug="$root/.local/share/JetBrains/$name"   # snap
  if [[ " $REIMPORT " != *" idea "* ]]; then
    [ -f "$IDEA_MARKER" ] && return 0
    if compgen -G "$CONF_DIR/JetBrains/IntelliJIdea*/options" >/dev/null; then
      printf 'kept=existing\ndate=%s\n' "$(date -Is)" > "$IDEA_MARKER"
      log "Keeping the IntelliJ IDEA settings you already had (--reimport idea to use the flatpak ones)"
      return 0
    fi
  fi
  if old_app_running "$old" && ! offer_close_old idea "$old"; then
    warn "The flatpak IntelliJ IDEA is still running. Quit it (File > Exit) or run: session-setup --close-old"
    return 1
  fi
  if pgrep -f "$APPS/idea/" >/dev/null; then warn "Close the native IntelliJ IDEA and run again"; return 1; fi
  # the native settings (if any) go to backups so IntelliJ imports the flatpak ones again
  for d in "$CONF_DIR"/JetBrains/IntelliJIdea* "$conf" "$plug"; do
    [ -e "$d" ] || continue
    bak="$GOINFRE/backups/JetBrains-$(basename "$d")-$(date +%Y%m%d-%H%M%S)"
    { mkdir -p "$GOINFRE/backups" && mv "$d" "$bak"; } || { warn "Couldn't move $d out of the way"; return 1; }
    log "Moved the previous $(pretty "$d") to $bak"
  done
  log "Copying your IntelliJ IDEA settings from $(pretty "$old")"
  mkdir -p "$(dirname "$conf")" "$(dirname "$plug")"
  if ! { rsync -a "${CACHE_EXCLUDES[@]}" "$old/" "$conf.partial/" && mv "$conf.partial" "$conf" &&
         { [ ! -d "$oldplug" ] || { rsync -a "$oldplug/" "$plug.partial/" && mv "$plug.partial" "$plug"; }; } &&
         printf 'from=%s\ndate=%s\n' "$old" "$(date -Is)" > "$IDEA_MARKER"; }; then
    warn "Copying the IntelliJ IDEA settings failed"; return 1
  fi
  [ -z "$root" ] || carry_tool_configs "$root"
}

vscode_ready() { [ -x "$APPS/vscode/bin/code" ] && { [ -z "$OLD_VSCODE" ] || [ -f "$NEW_VSCODE/$MARKER" ]; }; }
brave_ready()  { [ -x "$APPS/brave/brave" ]     && { [ -z "$OLD_BRAVE" ]  || [ -f "$NEW_BRAVE/$MARKER" ]; }; }
idea_ready()   { [ -x "$APPS/idea/bin/idea" ]   && { [ -z "$OLD_IDEA" ]   || [ -f "$IDEA_MARKER" ]; }; }

# IntelliJ's caches and indexes grow to gigabytes and are rebuilt when missing: goinfre
idea_properties() {
  local dir sys
  dir=$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1]))["dataDirectoryName"])' \
        "$APPS/idea/product-info.json") || return 0
  sys="$GOINFRE/cache/JetBrains/$dir"
  printf 'idea.system.path=%s\nidea.log.path=%s\n' "$sys" "$sys/log" > "$STATE_DIR/idea.properties"
  export IDEA_PROPERTIES="$STATE_DIR/idea.properties"
  # IntelliJ notes its process ID in .lock (settings, home) and .pid/.port (caches) and
  # leaves them behind when it doesn't shut down cleanly, like logging out with it open.
  # If the ID belongs to a process it can't inspect by the next start (root's, on another
  # post), it takes it for a stuck copy of itself and refuses to start. With no IntelliJ
  # running on this post, those files can only be leftovers.
  if ! pgrep -f '/bin/idea( |$)|com\.intellij\.idea\.Main' >/dev/null; then
    rm -f "$sys/.port" "$sys/.pid"
    if ! home_is_shared "$CONF_DIR"; then rm -f "$CONF_DIR/JetBrains/$dir/.lock"; fi
  fi
}

# downloaded .vsix files are only a cache, keep them off the home quota
link_vsix_cache() {
  mkdir -p "$GOINFRE/cache/vscode-vsix" "$NEW_VSCODE"
  [ -L "$NEW_VSCODE/CachedExtensionVSIXs" ] || rm -rf "$NEW_VSCODE/CachedExtensionVSIXs"
  ln -sfn "$GOINFRE/cache/vscode-vsix" "$NEW_VSCODE/CachedExtensionVSIXs"
}

# --- launchers -------------------------------------------------------------------

# copy this script to ~/.local/bin so it keeps working wherever it was run from
install_self() {
  local target="$INSTALL_DIR/session-setup"
  [ "$SELF" = "$(readlink -f "$target" 2>/dev/null)" ] && return 0
  mkdir -p "$INSTALL_DIR"
  if ! cmp -s "$SELF" "$target"; then
    install -m 755 "$SELF" "$target"
    log "Installed $(pretty "$target")"
  fi
  SELF=$target
}

# write_wrapper COMMAND APP, without overwriting a command that isn't ours
write_wrapper() {
  local f="$INSTALL_DIR/$1"
  if [ -e "$f" ] && ! grep -qs 'session-setup' "$f"; then
    warn "$(pretty "$f") already exists and isn't from session-setup, leaving it alone"; return 0
  fi
  printf '#!/bin/sh\nexec "%s" open %s "$@"\n' "$SELF" "$2" > "$f" && chmod +x "$f"
}

write_launchers() {
  local icon_vscode icon_brave rc exec=$SELF
  write_wrapper code vscode
  write_wrapper brave brave
  # quote only when needed: xdg-settings can't read a quoted Exec path
  [[ $exec == *[[:space:]]* ]] && exec="\"$exec\""

  # the flatpak's icon if there is one, else the app's own
  icon_vscode=$(app_root "$OLD_VSCODE"); icon_brave=$(app_root "$OLD_BRAVE")
  if [[ $icon_vscode == "$HOME/.var/app/"* ]]; then icon_vscode=$(basename "$icon_vscode")
  else icon_vscode="$APPS/vscode/resources/app/resources/linux/code.png"; fi
  if [[ $icon_brave == "$HOME/.var/app/"* ]]; then icon_brave=$(basename "$icon_brave")
  else icon_brave="$APPS/brave/product_logo_256.png"; fi

  mkdir -p "$DATA_DIR/applications"
  cat > "$DATA_DIR/applications/code-native.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=VS Code (native)
Comment=VS Code from goinfre, using the GPU
Exec=$exec open vscode %F
Icon=$icon_vscode
Categories=Development;IDE;
StartupWMClass=code
EOF
  cat > "$DATA_DIR/applications/brave-native.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Brave (native)
Comment=Brave from goinfre, using the GPU
Exec=$exec open brave %U
Icon=$icon_brave
Categories=Network;WebBrowser;
MimeType=text/html;x-scheme-handler/http;x-scheme-handler/https;
StartupWMClass=$BRAVE_WM_CLASS
EOF
  if optional_on idea; then
    write_wrapper idea idea
    cat > "$DATA_DIR/applications/idea-native.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=IntelliJ IDEA (native)
Comment=IntelliJ IDEA from goinfre, outside the flatpak sandbox
Exec=$exec open idea %F
Icon=$APPS/idea/bin/idea.svg
Categories=Development;IDE;Java;
StartupWMClass=jetbrains-idea
EOF
  fi

  case "$(basename "${SHELL:-}")" in
    zsh)  rc="$HOME/.zshrc" ;;
    bash) rc="$HOME/.bashrc" ;;
    *)    return 0 ;;
  esac
  if ! grep -qs '# Added by session-setup' "$rc"; then
    # shellcheck disable=SC2016  # $PATH has to stay literal in the rc file
    printf '\n# Added by session-setup: personal commands (code, brave, session-setup)\nexport PATH="%s:$PATH"\n' \
      "${INSTALL_DIR/#$HOME/\$HOME}" >> "$rc"
    log "Added $(pretty "$INSTALL_DIR") to your PATH in $(pretty "$rc"), open a new terminal to use it"
  fi
}

# Links clicked in other apps should open the new Brave, not the flatpak one with
# the old profile. Only done when the flatpak Brave is the default browser.
claim_default_browser() {
  local old_id current
  old_id=$(app_root "$OLD_BRAVE")
  [[ $old_id == "$HOME/.var/app/"* ]] || return 0
  old_id="$(basename "$old_id").desktop"
  current=$(xdg-settings get default-web-browser 2>/dev/null || true)
  [ "$current" = "$old_id" ] || return 0
  if xdg-settings set default-web-browser brave-native.desktop 2>/dev/null; then
    log "Links from other apps now open the new Brave instead of the flatpak one"
  fi
}

# --- steps -----------------------------------------------------------------------

prepare() {
  local failed=0
  if [ "$GOINFRE" = "$HOME/.local/opt" ]; then
    warn "No goinfre on this post, installing in $(pretty "$GOINFRE") (about 1.5 GB of your home)"
  fi
  install_self
  install_vscode || failed=1
  install_brave  || failed=1
  import_data vscode "$OLD_VSCODE" "$NEW_VSCODE" || failed=1
  import_data brave  "$OLD_BRAVE"  "$NEW_BRAVE"  || failed=1
  if vscode_ready; then link_vsix_cache; fi
  write_launchers
  if brave_ready; then claim_default_browser; fi
  return $failed
}

# only once it's turned on, and after the other two are open: it's a big download
prepare_idea() {
  optional_on idea || return 0
  install_idea && import_idea
}

add_idea() {
  if ! optional_on idea; then
    mkdir -p "$STATE_DIR" && echo idea >> "$OPTIONAL"
    log "IntelliJ IDEA turned on: it's set up from now on, on every post (session-setup --remove idea to stop)"
  fi
}

remove_idea() {
  local f
  if pgrep -f "$APPS/idea/" >/dev/null; then warn "Close IntelliJ IDEA first"; return 1; fi
  if [ -f "$OPTIONAL" ]; then grep -vx idea "$OPTIONAL" > "$OPTIONAL.new" || true; mv "$OPTIONAL.new" "$OPTIONAL"; fi
  f="$INSTALL_DIR/idea"
  if grep -qs 'session-setup' "$f"; then rm -f "$f"; fi
  rm -f "$DATA_DIR/applications/idea-native.desktop"
  rm -rf "$APPS/idea"
  log "IntelliJ IDEA turned off and removed from this post's goinfre." \
      "Your settings stay in $(pretty "$CONF_DIR/JetBrains")"
}

free_ram() {
  # the software center's background updater, ~300 MB; GNOME starts it again at next login
  if pkill -f 'gnome-software --gapplication-service'; then
    log "Stopped the gnome-software background service (~300 MB of RAM back)"
  fi
}

launch_apps() {
  local old
  if vscode_ready && ! pgrep -f "$APPS/vscode/" >/dev/null; then
    log "Opening VS Code"
    setsid -f "$SELF" open vscode >/dev/null 2>&1
  fi
  if brave_ready && ! pgrep -f "$APPS/brave/" >/dev/null; then
    log "Opening Brave"
    setsid -f "$SELF" open brave >/dev/null 2>&1
  fi
  for old in "$OLD_VSCODE" "$OLD_BRAVE"; do
    if [ -n "$old" ] && old_app_running "$old"; then
      warn "$(basename "$(app_root "$old")") (flatpak) is still running and renders on the CPU." \
           "session-setup --close-old closes it"
    fi
  done
}

# A lock another post left in the home folder is stale: the home is only mounted on one
# post at a time. Not so on a network filesystem several posts can use at once.
home_is_shared() {
  case "$(stat -f -c %T "$1" 2>/dev/null)" in nfs*|cifs|smb*|afs|ceph|fuse*) return 0 ;; esac
  return 1
}

# Brave locks its profile with a SingletonLock link to "<host>-<pid>". Leave a post
# with Brave still open and the lock stays in your home; Brave on the next post then
# refuses to start, as it can't check a process on another computer. A home that is
# mounted on one post at a time can't be in use elsewhere, so that lock is stale.
clear_stale_brave_lock() {
  local owner host
  owner=$(readlink "$NEW_BRAVE/SingletonLock" 2>/dev/null) || return 0
  host=${owner%-*}
  [ "$host" != "$(uname -n)" ] || return 0   # Brave sorts out locks from this post itself
  if home_is_shared "$NEW_BRAVE"; then return 0; fi
  rm -f "$NEW_BRAVE/SingletonLock" "$NEW_BRAVE/SingletonCookie" "$NEW_BRAVE/SingletonSocket"
  log "Unlocked the Brave profile (left locked by $host)"
}

# what `code`, `brave` and the app grid entries run: set things up if this post
# doesn't have the app yet, then start it
open_app() {
  local name=$1; shift
  if [ "$name" = idea ] && ! optional_on idea; then
    echo "IntelliJ IDEA is optional, turn it on with: session-setup --add idea" >&2
    notify "IntelliJ IDEA is optional, turn it on with: session-setup --add idea"; exit 1
  fi
  if ! "${name}_ready"; then
    if [ "$name" = idea ]; then notify "Getting IntelliJ IDEA ready on this post, takes a few minutes..."
    else notify "Getting $(label "$name") ready on this post, takes about a minute..."; fi
    # wait for a run that may already be setting things up, then check again
    flock -w 600 9 || { notify "session-setup is busy, try again in a minute"; exit 1; }
    if ! "${name}_ready"; then
      { prepare; if [ "$name" = idea ]; then prepare_idea; fi; } >"$STATE_DIR/last-run.log" 2>&1 || true
    fi
    if ! "${name}_ready"; then
      notify "$(label "$name") isn't ready: $(grep -h '^!!' "$STATE_DIR/last-run.log" | tail -n1 | cut -c5-)"
      exit 1
    fi
  fi
  exec 9>&-   # don't hand the lock to the app
  case "$name" in
    vscode)
      local node_bin; node_bin=$(find_node_bin)
      export PATH="$INSTALL_DIR${node_bin:+:$node_bin}:$PATH"
      exec "$APPS/vscode/bin/code" --extensions-dir "$VSCODE_EXTENSIONS" "$@" ;;
    brave)
      clear_stale_brave_lock
      exec "$APPS/brave/brave" --class="$BRAVE_WM_CLASS" --disk-cache-size="$BRAVE_CACHE_BYTES" "$@" ;;
    idea)
      idea_properties
      exec "$APPS/idea/bin/idea" "$@" ;;
  esac
}

main() {
  MODE=full REIMPORT="" CLOSE_OLD=0 FROM_FLATPAK="" ADD="" REMOVE=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --prepare)      MODE=prepare ;;
      --close-old)    CLOSE_OLD=1 ;;
      --from-flatpak) FROM_FLATPAK=${2:-}; shift ;;
      --reimport)
        case "${2:-}" in
          vscode|code)   REIMPORT=vscode; shift ;;
          brave)         REIMPORT=brave; shift ;;
          idea|intellij) REIMPORT=idea; shift ;;
          *)             REIMPORT="vscode brave idea" ;;
        esac ;;
      --add|--remove)
        case "${2:-}" in
          idea|intellij) if [ "$1" = --add ]; then ADD=idea; else REMOVE=idea; fi; shift ;;
          *) echo "usage: session-setup $1 idea" >&2; exit 2 ;;
        esac ;;
      open)
        case "${2:-}" in
          vscode|code)   OPEN_APP=vscode ;;
          brave)         OPEN_APP=brave ;;
          idea|intellij) OPEN_APP=idea ;;
          *) echo "usage: session-setup open vscode|brave|idea [ARGS]" >&2; exit 2 ;;
        esac
        MODE=open; shift 2; break ;;
      -h|--help) usage; exit 0 ;;
      --version) echo "session-setup $VERSION"; exit 0 ;;
      *) echo "unknown option: $1 (see --help)" >&2; exit 2 ;;
    esac
    shift
  done

  GOINFRE=$(find_goinfre)
  APPS="$GOINFRE/apps"
  OLD_VSCODE=$(newest "$HOME"/.var/app/*/config/Code "$HOME"/snap/code/current/.config/Code)
  OLD_BRAVE=$(newest "$HOME"/.var/app/*/config/BraveSoftware/Brave-Browser \
                     "$HOME"/snap/brave/current/.config/BraveSoftware/Brave-Browser)
  OLD_IDEA=$(newest "$HOME"/.var/app/com.jetbrains.IntelliJ-IDEA-*/config/JetBrains/IdeaIC* \
                    "$HOME"/.var/app/com.jetbrains.IntelliJ-IDEA-*/config/JetBrains/IntelliJIdea* \
                    "$HOME"/snap/intellij-idea-*/current/.config/JetBrains/I*)
  VSCODE_EXTENSIONS=$(find_vscode_extensions)
  if ! mkdir -p "$APPS" 2>/dev/null; then
    echo "Can't write to $GOINFRE. Set GOINFRE to a folder you own, e.g. GOINFRE=/goinfre/$USER session-setup" >&2
    exit 1
  fi
  chmod 700 "$GOINFRE" 2>/dev/null || true
  mkdir -p "$STATE_DIR"

  # one run at a time (a terminal run and a click on an app entry, for example)
  exec 9>"$STATE_DIR/lock"
  if [ "$MODE" = open ]; then open_app "$OPEN_APP" "$@"; fi
  if ! flock -n 9; then echo "session-setup is already running" >&2; exit 1; fi
  if [ -n "$REMOVE" ]; then remove_idea; exit; fi
  if [ -n "$ADD" ]; then add_idea; fi

  log "goinfre:            $GOINFRE"
  log "flatpak VS Code:    $(pretty "${OLD_VSCODE:-not found}")"
  log "VS Code extensions: $(pretty "$VSCODE_EXTENSIONS")"
  log "flatpak Brave:      $(pretty "${OLD_BRAVE:-not found}")"
  if optional_on idea; then log "flatpak IntelliJ:   $(pretty "${OLD_IDEA:-not found}")"; fi

  if [ "$CLOSE_OLD" = 1 ]; then
    [ -z "$OLD_VSCODE" ] || close_old_app vscode "$OLD_VSCODE" || FAILED=1
    [ -z "$OLD_BRAVE" ]  || close_old_app brave "$OLD_BRAVE" || FAILED=1
    if optional_on idea && [ -n "$OLD_IDEA" ]; then close_old_app idea "$OLD_IDEA" || FAILED=1; fi
  fi
  rm -rf "$GOINFRE"/.download.*   # left by a run that was interrupted (we hold the lock)
  prepare || FAILED=1
  if [ "$MODE" = full ]; then
    free_ram
    launch_apps
  fi
  prepare_idea || FAILED=1
  if [ -n "$OLD_IDEA" ] && ! optional_on idea && [ ! -e "$STATE_DIR/idea-hint" ]; then
    log "You also have the flatpak IntelliJ IDEA. To set up a native one too: session-setup --add idea"
    touch "$STATE_DIR/idea-hint"
  fi
  if [ "$FAILED" = 0 ]; then log "Done."; else warn "Done, but with warnings (see above)"; exit 1; fi
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then main "$@"; fi
